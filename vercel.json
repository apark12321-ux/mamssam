{
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "mamssam.vercel.app" }], "destination": "https://toppick.vercel.app/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
